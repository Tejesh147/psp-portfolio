---
interface Props {
  /** "lush" on the XMB landing, "subdued" on inner pages */
  intensity?: "lush" | "subdued";
}
const { intensity = "lush" } = Astro.props;
---

<div class={`wave-bg wave-bg--${intensity}`} aria-hidden="true">
  <div class="wave wave-1"></div>
  <div class="wave wave-2"></div>
  <div class="wave wave-3"></div>
  <div class="wave wave-4"></div>
  <div class="light-streak"></div>
</div>

<style>
  .wave-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: linear-gradient(135deg, var(--bg-grad-1) 0%, var(--bg-grad-2) 100%);
  }

  .wave {
    position: absolute;
    width: 200%;
    height: 200%;
    left: -50%;
    border-radius: 40%;
    will-change: transform;
    animation: waveRotate linear infinite;
  }

  .wave-1 { bottom: -120%; background: radial-gradient(ellipse, #1565c0 0%, transparent 70%); animation-duration: 22s; opacity: 0.25; }
  .wave-2 { bottom: -125%; background: radial-gradient(ellipse, #0d47a1 0%, transparent 70%); animation-duration: 26s; animation-direction: reverse; opacity: 0.18; }
  .wave-3 { bottom: -130%; background: radial-gradient(ellipse, #42a5f5 0%, transparent 60%); animation-duration: 30s; opacity: 0.12; }
  .wave-4 { bottom: -115%; background: radial-gradient(ellipse, #7c4dff 0%, transparent 65%); animation-duration: 35s; animation-direction: reverse; opacity: 0.10; }

  .wave-bg--subdued .wave { opacity: 0.06; }

  .light-streak {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06) 20%, rgba(255,255,255,0.10) 50%, rgba(255,255,255,0.06) 80%, transparent);
  }

  @keyframes waveRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave { animation: none !important; }
  }
</style>
