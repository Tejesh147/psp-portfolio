---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  number?: string;
}
const { src, alt, caption, number = "01" } = Astro.props;
---

<figure class="figure">
  <div class="figure-frame">
    <Image src={src} alt={alt} loading="lazy" />
  </div>
  <figcaption class="figure-cap">FIG.{number} — {caption}</figcaption>
</figure>

<style>
  .figure { margin: var(--space-6) 0; }
  .figure-frame {
    background: var(--surface-1);
    border: 1px solid var(--surface-stroke);
    border-radius: 6px;
    overflow: hidden;
  }
  .figure-cap {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-muted);
    letter-spacing: 0.5px;
    text-align: center;
  }
</style>
