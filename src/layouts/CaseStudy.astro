---
import Base from "./Base.astro";
import { Image } from "astro:assets";
import Tag from "../components/content/Tag.astro";
import Figure from "../components/content/Figure.astro";
import Hairline from "../components/content/Hairline.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}
const { project, prev, next } = Astro.props;
const data = project.data;
const heroStyle = !data.hero
  ? "background: linear-gradient(135deg, #1565c0, #7c4dff);"
  : "";
const projectId = `PRJ://${String(data.order).padStart(3, "0")}`;
---

<Base
  title={`${data.title} — Tejesh Arujuna`}
  backHref="/"
  context={projectId}
  waveIntensity="subdued"
>
  <article class="case-study">
    <section class="hero" style={heroStyle}>
      {data.hero && <Image src={data.hero.src} alt={data.hero.alt} class="hero-img" />}
      <div class="hero-meta">
        <div class="hero-eyebrow">PROJECT · {data.year}</div>
        <h1 class="hero-title">{data.title}</h1>
        <div class="hero-strip">
          ROLE // {data.role}
          &nbsp;·&nbsp; STACK // {data.stack.join(", ")}
          &nbsp;·&nbsp; STATUS // {data.status.toUpperCase()}
        </div>
      </div>
    </section>

    <div class="body">
      <div class="hook" set:html={data.hookHtml}></div>

      {data.figure && (
        <Figure
          src={data.figure.src}
          alt={data.figure.alt}
          caption={data.figure.caption}
          number="01"
        />
      )}

      <Hairline />

      <slot />

      {data.tags.length > 0 && (
        <div class="tags">
          {data.tags.map((t) => <Tag>{t}</Tag>)}
        </div>
      )}
    </div>

    {(prev || next) && (
      <nav class="project-nav" aria-label="Project navigation">
        <div>
          {prev && <a href={`/projects/${prev.slug}`}>← {prev.title.toUpperCase()}</a>}
        </div>
        <div>
          {next && <a href={`/projects/${next.slug}`}>{next.title.toUpperCase()} →</a>}
        </div>
      </nav>
    )}
  </article>
</Base>

<style>
  .case-study { position: relative; }

  .hero {
    position: relative;
    height: 280px;
    margin-top: 36px;
    display: flex;
    align-items: flex-end;
    padding: var(--space-8);
    overflow: hidden;
  }
  .hero-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-meta { position: relative; z-index: 1; }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--accent);
    margin-bottom: var(--space-3);
  }
  .hero-title {
    font-size: var(--text-4xl);
    font-weight: 600;
    letter-spacing: -0.5px;
    line-height: 1.1;
    margin: 0;
  }
  .hero-strip {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 13px;
    color: rgba(255,255,255,0.7);
    letter-spacing: 1.5px;
  }

  .body {
    max-width: 720px;
    margin: var(--space-12) auto;
    padding: 0 var(--space-8);
    counter-reset: section-counter;
  }

  .hook { font-size: var(--text-lg); line-height: 1.6; color: rgba(255,255,255,0.9); }

  .body :global(h2) {
    counter-increment: section-counter;
    font-size: var(--text-xl);
    margin: var(--space-12) 0 var(--space-3);
  }

  .body :global(h2)::before {
    content: "// " counter(section-counter, decimal-leading-zero);
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .tags {
    margin-top: var(--space-12);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .project-nav {
    border-top: 1px solid var(--surface-stroke);
    padding: var(--space-6) var(--space-8);
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-muted);
  }
</style>
